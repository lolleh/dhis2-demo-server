# Copy to .env and adjust. docker compose loads this automatically;
# .env is gitignored so secrets never land in the repo.

DHIS2_IMAGE=dhis2/core-dev:latest
DB_USERNAME=dhis
DB_PASSWORD=dhis
DB_NAME=dhis
DHIS2_DB_DUMP_URL=https://databases.dhis2.org/sierra-leone/dev/dhis2-db-sierra-leone.sql.gz

# ============================================================================
# Interop Bridge - primary OpenMRS (REST) source
# ----------------------------------------------------------------------------
# The bridge runs inside Docker, so "localhost" means the container itself.
# Use a DNS name or the Docker host's LAN IP for any external server.
# Default (local PIH SL EMR): http://openmrs:8080/openmrs
# ============================================================================
OPENMRS_URL=http://openmrs:8080/openmrs
# Built locally whenever `docker compose up` runs (pull_policy: build) from the
# reproducible distribution assembled into distro/target/distro/web by the
# OpenMRS SDK (run scripts/seed-distro-maven-repo.sh + scripts/build-distro.sh
# once per machine first - see README "Building the OpenMRS distribution").
# OPENMRS_IMAGE only names the resulting image. To run the plain stock image
# instead, remove the `build:`/`pull_policy: build` keys from the openmrs
# service and set OPENMRS_IMAGE=partnersinhealth/pihsl-emr:latest here.
OPENMRS_IMAGE=dhis2-demo-openmrs:latest
OPENMRS_PIH_CONFIG=sierraLeone,sierraLeone-kgh,sierraLeone-kgh-test
OPENMRS_USERNAME=admin
OPENMRS_PASSWORD=Admin123

# TLS to the external OpenMRS (https only - ignored for http)
# Self-signed / private CA: set OPENMRS_TLS_INSECURE=true (dev only) OR
# mount your CA bundle into the container (/app/certs) and set the CA_FILE.
# mTLS: set CERT_FILE + KEY_FILE together.
# OPENMRS_TLS_INSECURE=false
# OPENMRS_TLS_CA_FILE=/app/certs/chain.pem
# OPENMRS_TLS_CERT_FILE=/app/certs/client.pem
# OPENMRS_TLS_KEY_FILE=/app/certs/client.key

# ============================================================================
# Interop Bridge - direct OpenMRS MySQL source (optional, per mapping)
# ----------------------------------------------------------------------------
# Set source_db='mysql' on a mapping to read its encounters straight from an
# external OpenMRS database instead of the REST API. The table schema is the
# standard OpenMRS one; the mysql2 client handles MySQL 5.7 / 8.x.
# Default: the local demo database (openmrs-db). Leave these at the defaults
# unless you are pointing at an external database.
# ============================================================================
OPENMRS_DB_HOST=openmrs-db
OPENMRS_DB_PORT=3306
OPENMRS_DB_NAME=openmrs
OPENMRS_DB_USER=openmrs
OPENMRS_DB_PASSWORD=Admin123

# ============================================================================
# Interop Bridge - DHIS2 endpoint
# ----------------------------------------------------------------------------
# Leave as-is when DHIS2 stays local. Only set DHIS2_URL* when the bridge
# should talk to an external DHIS2 as well (TLS vars mirror the OpenMRS ones).
# ============================================================================
# DHIS2_URL=http://web:8080
# DHIS2_USERNAME=admin
# DHIS2_PASSWORD=district
# DHIS2_TLS_INSECURE=false
# DHIS2_TLS_CA_FILE=
# DHIS2_TLS_CERT_FILE=
# DHIS2_TLS_KEY_FILE=

# ============================================================================
# CommCare configuration (optional - uncomment and fill in)
# ============================================================================
# COMMCARE_DOMAIN=yourdomain.commcarehq.org
# COMMCARE_API_KEY=your_api_key
# COMMCARE_USERNAME=your_commcare_username
# COMMCARE_APP_ID=your_app_id